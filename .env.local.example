# ============================================================
# TRAINERBOOST — Variables de entorno (plantilla)
# Copia como .env.local y rellena los valores reales
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard → Products (una recurring price por plan)
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_UNLIMITED=price_...

# ── App ───────────────────────────────────────────────────
# http://localhost:3000 en local, https://app.trainerboost.es en producción
NEXT_PUBLIC_APP_URL=http://localhost:3000
