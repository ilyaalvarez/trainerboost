# ============================================================
# TRAINERBOOST — Variables de entorno (plantilla)
# Copia como .env.local y rellena los valores reales
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard → Products (una recurring price por plan)
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_UNLIMITED=price_...

# ── Resend (emails transaccionales) ───────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_...

# ── App ───────────────────────────────────────────────────
# http://localhost:3000 en local, https://trainerboost.es en producción
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Push Notifications (VAPID) ────────────────────────────
# Genera un par de claves: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BN...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:hola@trainerboost.es

# ── Seguridad interna ─────────────────────────────────────
# Secreto para llamadas internas server→server (push/send, etc.)
# Genera con: openssl rand -hex 32
INTERNAL_API_SECRET=...

# ── Vercel Cron ───────────────────────────────────────────
# En producción Vercel lo inyecta automáticamente.
# Para testing local, pon cualquier string y úsalo en el header:
#   Authorization: Bearer <valor>
CRON_SECRET=...

# ── Sentry (monitorización de errores) ───────────────────
# sentry.io → proyecto → Settings → Client Keys → DSN
NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.de.sentry.io/...
SENTRY_DSN=https://...@....ingest.de.sentry.io/...
# sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=sntryu_...
SENTRY_ORG=trainerboost
SENTRY_PROJECT=javascript-nextjs

# ── Upstash Redis (rate limiting) ─────────────────────────
# console.upstash.com → Database → REST API
# Sin estas vars el rate limiting se deshabilita silenciosamente.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=A...
