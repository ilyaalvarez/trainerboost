{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/api/webhooks/stripe",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://trainerboost.es"
  },
  "crons": [
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/weekly-checkins",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/streak-alerts",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 12 * * *"
    }
  ]
}
